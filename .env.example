# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console verification token (optional, add to deployment env when available)
NEXT_PUBLIC_GSC_VERIFICATION=

# Contact form endpoint. Keep blank to use the same-origin Cloudflare Pages Function at /api/contact.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Optional Cloudflare Turnstile site key for the contact form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Contact form delivery settings for Cloudflare Pages Functions.
# Configure either Resend or a webhook in Cloudflare Pages environment variables.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
CONTACT_WEBHOOK_URL=
TURNSTILE_SECRET_KEY=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
