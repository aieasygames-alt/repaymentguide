# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console verification token (optional, add to deployment env when available)
NEXT_PUBLIC_GSC_VERIFICATION=

# Contact form endpoint. Keep blank to use /api/contact on Cloudflare Pages.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Optional Cloudflare Turnstile site key for the contact form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Contact delivery settings for Cloudflare Pages environment variables.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
CONTACT_WEBHOOK_URL=
TURNSTILE_SECRET_KEY=
